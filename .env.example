# Base URL of the VRLabs package API. Defaults to the production API when unset.
API_URL=https://api.vrlabs.dev

# Public origin of the site, used for canonical URLs, Open Graph tags and the Discord embed.
ORIGIN=https://vrlabs.dev

# Optional fine-grained GitHub personal access token (public repositories and read-only)
# so do download counts can be fetched at 5,000 requests per hour instead of 60.
GITHUB_TOKEN=

# Port the node server listens on. With docker compose this is the host port, the container
# always listens on 3000.
PORT=3000
